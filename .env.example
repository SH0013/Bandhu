# Google Gemini & GenAI SDK Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=(default)
GCS_AUDIO_BUCKET=bandhu-audio-vault

# Caregiver Emergency Notification — FREE / freemium channels (in order of preference)

# 1. Telegram Bot API (PRIMARY — free forever, ~5 min setup)
#    To enable: create a bot via @BotFather, set the token below, and
#    either set the webhook via `curl https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<your-host>/api/webhook/telegram`
#    OR use long polling (no webhook needed for dev).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
CAREGIVER_TELEGRAM_CHAT_ID=123456789

# 2. Meta WhatsApp Cloud API (direct, free tier: 1,000 service conversations/month)
#    To enable: create a Meta Business account, get a WhatsApp Business number,
#    set webhook to https://<your-host>/api/webhook/whatsapp with the verify token below.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=bandhu_secure_verify_token_2026
CAREGIVER_PHONE_NUMBER=+91-XXXXXXXXXX
CAREGIVER_EMAIL=family_caregiver@example.com

# 3. Twilio (NOT RECOMMENDED — costs ~$0.012/msg + $1.15/month phone rental)
#    Twilio is supported only as a legacy path; leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Server & Runtime Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
USE_SQLITE_FALLBACK=true
TTS_MODE=auto
