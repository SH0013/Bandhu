# Google Gemini & GenAI SDK Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=(default)
GCS_AUDIO_BUCKET=bandhu-audio-vault

# WhatsApp Webhook Configuration (Twilio Sandbox or Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=bandhu_secure_verify_token_2026
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Caregiver Emergency Notification Dispatch
CAREGIVER_PHONE_NUMBER=+919876543210
CAREGIVER_EMAIL=family_caregiver@example.com

# Server & Runtime Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
USE_SQLITE_FALLBACK=true
TTS_MODE=auto
